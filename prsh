# ---------------- CPU / RAM / storage helpers (kept concise) ----------------
sub read_cpu_times { return () unless -f '/proc/stat'; open my $fh,'<','/proc/stat' or return (); while (<$fh>) { if (/^cpu\s+(.*)/) { close $fh; my @v = map { int($_) } split /\s+/, $1; return @v } } close $fh; return (); }
sub calculate_cpu_usage {
    my (@prev)=@{$_[0]}; my (@cur)=@{$_[1]}; return 0 unless @prev && @cur;
    my $prev_idle = ($prev[3]||0)+($prev[4]||0);
    my $idle = ($cur[3]||0)+($cur[4]||0);
    my $prev_non = ($prev[0]||0)+($prev[1]||0)+($prev[2]||0)+($prev[5]||0)+($prev[6]||0)+($prev[7]||0);
    my $non = ($cur[0]||0)+($cur[1]||0)+($cur[2]||0)+($cur[5]||0)+($cur[6]||0)+($cur[7]||0);
    my $prev_total = $prev_idle + $prev_non; my $total = $idle + $non;
    my $totald = $total - $prev_total; my $idled = $idle - $prev_idle;
    return 0 if $totald <= 0; return (($totald - $idled) / $totald) * 100;
}
sub cpu_info { if (-f '/proc/stat' && -f '/proc/cpuinfo') { my @p1 = read_cpu_times; sleep 0.05; my @p2 = read_cpu_times; my $usage = sprintf("%.1f", calculate_cpu_usage(\@p1,\@p2)); my $cores=0; my @freqs; open my $fh,'<','/proc/cpuinfo'; while (<$fh>) { $cores++ if /^processor\s*:\s*\d+/; push @freqs, sprintf("%.0fMHz",$1) if /^cpu MHz\s*:\s*([\d.]+)/ } close $fh; my $freq_display = @freqs ? join(", ", @freqs[0..($cores-1)]) : "N/A"; return color("CPU Usage:",36)." ".color("$usage%",33)." | ".color("Cores:",36)." ".color($cores,32)." | ".color("Freqs:",36)." ".color($freq_display,35) } return color("CPU Usage:",36)." Info not available" }
sub ram_info { if (-f '/proc/meminfo') { my %m; open my $fh,'<','/proc/meminfo'; while (<$fh>) { if (/^(\S+):\s+(\d+)/) { $m{$1} = $2 * 1024 } } close $fh; my $total = $m{MemTotal} || 0; my $avail = $m{MemAvailable} || $m{MemFree} || 0; my $used = $total - $avail; return color("RAM Usage:",36)." ".color(human_bytes($used),33)." / ".color(human_bytes($total),32) } return color("RAM Usage:",36)." Info not available" }
sub storage_info { my $cwd = Cwd::getcwd(); my $out = qx(df -B1 "$cwd" 2>/dev/null); if ($? == 0 && $out =~ /\S/) { my @lines = split /\n/, $out; my $line = $lines[-1]; my @f = split /\s+/, $line; my ($total, $used) = ($f[1] // 0, $f[2] // 0); return color("Storage Usage ($cwd):",36)." ".color(human_bytes($used),33)." / ".color(human_bytes($total),32) } return color("Storage Usage:",36)." Info not available" }

# ---------------- package counting ----------------
sub which { for my $d (split /:/, $ENV{PATH}) { next unless defined $d && $d ne ''; my $f = File::Spec->catfile($d, $_[0]); return $f if -x $f } return undef }
sub run_and_count_lines { my ($cmd)=@_; my $out = qx($cmd 2>/dev/null); return 0 unless defined $out && $out ne ''; return scalar split /\n/,$out }
sub detect_pkg_manager_and_count {
    if (which('dpkg')) { my $c = run_and_count_lines("dpkg -l | grep -E '^ii\\s' || true"); return ('dpkg',$c,"dpkg (Debian/Ubuntu)"); }
    if (which('rpm')) { my $c = run_and_count_lines('rpm -qa'); return ('rpm',$c,"rpm (RHEL/Fedora/openSUSE)"); }
    if (which('pacman')) { my $c = run_and_count_lines('pacman -Q'); return ('pacman',$c,"pacman (Arch)"); }
    if (which('apk')) { my $c = run_and_count_lines('apk info'); return ('apk',$c,"apk (Alpine)"); }
    if (which('pkg')) { my $c = run_and_count_lines('pkg info'); return ('pkg',$c,"pkg (FreeBSD/Termux)"); }
    if (which('flatpak')) { my $c = run_and_count_lines('flatpak list --app'); return ('flatpak',$c,"flatpak (flatpak apps)"); }
    if (which('snap')) { my $c = run_and_count_lines('snap list'); return ('snap',$c,"snap (snap packages)"); }
    return ('unknown',0,"unknown");
}

# ---------------- simple prsh-local package manager ----------------

my $PRSH_PKG_ROOT = File::Spec->catdir(home_dir(), ".prsh", "packages");
my $PRSH_LOCAL_BIN = File::Spec->catdir(home_dir(), ".local", "prsh", "bin");
make_path($PRSH_PKG_ROOT) unless -d $PRSH_PKG_ROOT;
make_path($PRSH_LOCAL_BIN) unless -d $PRSH_LOCAL_BIN;
$ENV{PATH} = $PRSH_LOCAL_BIN . ':' . ($ENV{PATH} // '');

sub _pkg_meta_file { my ($name) = @_; return File::Spec->catfile($PRSH_PKG_ROOT,$name,"meta.json"); }
sub _read_pkg_meta { my ($name) = @_; my $f = _pkg_meta_file($name); return {} unless -f $f; if(open my $fh,'<:encoding(UTF-8)',$f){ local $/; my $j = <$fh>; close $fh; my $h = eval { decode_json($j) }; return $h && ref($h) eq 'HASH' ? $h : {} } return {}; }
sub _write_pkg_meta { my ($name,$meta) = @_; my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$name); make_path($dir) unless -d $dir; my $f = _pkg_meta_file($name); if(open my $fh,'>:encoding(UTF-8)',$f){ print $fh encode_json($meta); close $fh; return 1 } return 0; }

sub _link_package_bins { my ($name) = @_; my $pkgdir = File::Spec->catdir($PRSH_PKG_ROOT,$name); my $bindir = File::Spec->catdir($pkgdir,'bin'); return unless -d $bindir; opendir my $dh,$bindir or return; while(my $f = readdir $dh){ next if $f =~ /^\./; my $src = File::Spec->catfile($bindir,$f); my $dst = File::Spec->catfile($PRSH_LOCAL_BIN,$f); unlink $dst if -l $dst; symlink $src,$dst unless -e $dst; } closedir $dh; }
sub _unlink_package_bins { my ($name)=@_; my $pkgdir = File::Spec->catdir($PRSH_PKG_ROOT,$name); my $bindir = File::Spec->catdir($pkgdir,'bin'); return unless -d $bindir; opendir my $dh,$bindir or return; while(my $f = readdir $dh){ next if $f =~ /^\./; my $dst = File::Spec->catfile($PRSH_LOCAL_BIN,$f); if(-l $dst){ my $target = readlink $dst; unlink $dst if defined $target && File::Spec->rel2abs($target) eq File::Spec->rel2abs(File::Spec->catfile($bindir,$f)); } } closedir $dh; }

sub pkg_install_git {
    my ($git_url) = @_;
    return say "Usage: pkg install <git_url>" unless $git_url;
    my ($pkgname) = $git_url =~ m{/([^/]+?)(?:\.git)?$};
    $pkgname ||= 'pkg_' . time();
    my $dest = File::Spec->catdir($PRSH_PKG_ROOT,$pkgname);
    if(-d $dest){ say color(":: ",35) . color("Package '$pkgname' is already installed",33); return }
    print color(":: ",35) . "Proceed with installation of " . color($pkgname,36) . "? [Y/n] ";
    my $answer = <STDIN>;
    chomp $answer if defined $answer;
    $answer //= '';
    if ($answer =~ /^n/i) { say color(":: ",35) . "Installation cancelled."; return; }
    say color(":: ",35) . "Retrieving package: " . color($pkgname,36);
    make_path($dest);
    open my $null, '>', '/dev/null' or die;
    my $old_stdout = select $null;
    my $rc = system('git','clone','--depth','1','--quiet',$git_url,$dest);
    select $old_stdout;
    close $null;
    if($rc != 0){ remove_tree($dest); say color("error: ",31) . "failed to retrieve package"; return }
    say color(":: ",35) . "Installing " . color($pkgname,36) . "...";
    my $meta = _read_pkg_meta($pkgname);
    $meta->{name} = $pkgname;
    $meta->{source} = $git_url;
    $meta->{type} = 'git';
    $meta->{enabled} = 1 unless defined $meta->{enabled};
    _write_pkg_meta($pkgname,$meta);
    _link_package_bins($pkgname);
    say color(":: ",35) . color("Successfully installed ",32) . color($pkgname,36);
}

sub pkg_install_local {
    my ($src) = @_;
    return say "Usage: pkg install /path/to/dir" unless $src;
    return say color("error: ",31) . "source directory not found" unless -d $src;
    my $pkgname = basename($src);
    my $dest = File::Spec->catdir($PRSH_PKG_ROOT,$pkgname);
    if(-d $dest){ say color(":: ",35) . color("Package '$pkgname' is already installed",33); return }
    print color(":: ",35) . "Proceed with installation of " . color($pkgname,36) . "? [Y/n] ";
    my $answer = <STDIN>;
    chomp $answer if defined $answer;
    $answer //= '';
    if ($answer =~ /^n/i) { say color(":: ",35) . "Installation cancelled."; return; }
    say color(":: ",35) . "Installing local package: " . color($pkgname,36);
    make_path($dest);
    my $rc = system('cp','-a',"$src/.",$dest);
    if($rc != 0){ remove_tree($dest); say color("error: ",31) . "copy operation failed"; return }
    my $meta = _read_pkg_meta($pkgname);
    $meta->{name} = $pkgname;
    $meta->{source} = Cwd::getcwd() . "/$src";
    $meta->{type} = 'local';
    $meta->{enabled} = 1 unless defined $meta->{enabled};
    _write_pkg_meta($pkgname,$meta);
    _link_package_bins($pkgname);
    say color(":: ",35) . color("Successfully installed ",32) . color($pkgname,36);
}

sub detect_system_pkg { return 'pkg' if which('pkg'); return 'apt' if which('apt-get') || which('apt'); return 'dnf' if which('dnf'); return 'pacman' if which('pacman'); return undef; }
sub pkg_install_system { my ($name) = @_; return say "Usage: pkg install --system <name>" unless $name; my $mgr = detect_system_pkg() or return say "No system package manager detected"; my @cmd; if($mgr eq 'pkg'){ @cmd = ('sudo','pkg','install','-y',$name) } elsif($mgr eq 'apt'){ @cmd = ('sudo','apt','install','-y',$name) } elsif($mgr eq 'pacman'){ @cmd = ('sudo','pacman','-S','--noconfirm',$name) } else { return say "System manager $mgr not supported" } system(@cmd) == 0 ? say "System package installed" : say "System install failed"; }

sub pkg_list { opendir my $dh,$PRSH_PKG_ROOT or return say "No packages"; while(my $d = readdir $dh){ next if $d =~ /^\./; my $meta = _read_pkg_meta($d) || {}; printf "%-20s %s %s\n", $d, ($meta->{version}//''), ($meta->{enabled} ? "[ENABLED]" : "[DISABLED]"); } closedir $dh; }

sub pkg_remove {
    my ($name)=@_;
    return say "Usage: pkg remove <name>" unless $name;
    my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$name);
    return say color("error: ",31) . "package '$name' is not installed" unless -d $dir;
    print color(":: ",35) . "Proceed with removal of " . color($name,36) . "? [Y/n] ";
    my $answer = <STDIN>;
    chomp $answer if defined $answer;
    $answer //= '';
    if ($answer =~ /^n/i) { say color(":: ",35) . "Removal cancelled."; return; }
    say color(":: ",35) . "Removing package: " . color($name,36);
    _unlink_package_bins($name);
    remove_tree($dir);
    say color(":: ",35) . color("Successfully removed ",32) . color($name,36);
}

sub pkg_enable { my ($name)=@_; return say "Usage: pkg enable <name>" unless $name; my $meta = _read_pkg_meta($name); $meta->{enabled} = 1; _write_pkg_meta($name,$meta); _link_package_bins($name); say "Enabled $name"; }
sub pkg_disable { my ($name)=@_; return say "Usage: pkg disable <name>" unless $name; my $meta = _read_pkg_meta($name); $meta->{enabled} = 0; _write_pkg_meta($name,$meta); _unlink_package_bins($name); say "Disabled $name"; }

sub pkg_update {
    my ($name)=@_;
    if(!$name || $name eq '--all'){
        say color(":: ",35) . "Synchronizing package databases...";
        my $count = 0;
        opendir my $dh,$PRSH_PKG_ROOT or return;
        while(my $d = readdir $dh){
            next if $d =~ /^\./;
            my $m = _read_pkg_meta($d);
            if($m->{type} && $m->{type} eq 'git'){
                say color(":: ",35) . "Updating " . color($d,36) . "...";
                my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$d);
                open my $null, '>', '/dev/null' or next;
                my $old_stdout = select $null;
                system('git','-C',$dir,'pull','--ff-only','--quiet');
                select $old_stdout;
                close $null;
                $count++;
            }
        }
        closedir $dh;
        say color(":: ",35) . color("Updated $count package(s)",32);
        return
    }
    my $meta = _read_pkg_meta($name);
    return say color("error: ",31) . "unknown package or not a git package" unless $meta && $meta->{type} eq 'git';
    say color(":: ",35) . "Updating " . color($name,36) . "...";
    my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$name);
    open my $null, '>', '/dev/null' or return say color("error: ",31) . "update failed";
    my $old_stdout = select $null;
    my $rc = system('git','-C',$dir,'pull','--ff-only','--quiet');
    select $old_stdout;
    close $null;
    if($rc == 0){ say color(":: ",35) . color("Successfully updated ",32) . color($name,36) } else { say color("error: ",31) . "update failed" }
}

sub pkg_info { my ($name)=@_; return say "Usage: pkg info <name>" unless $name; my $m = _read_pkg_meta($name); if(!$m || !%$m){ say "No metadata for $name"; return } for my $k (sort keys %$m){ printf "%-15s: %s\n", $k, $m->{$k} } }

sub load_enabled_packages { opendir my $dh,$PRSH_PKG_ROOT or return; while(my $d = readdir $dh){ next if $d =~ /^\./; my $m = _read_pkg_meta($d); next unless $m->{enabled}; if($m->{entry}){ my $entry = File::Spec->catfile($PRSH_PKG_ROOT,$d,$m->{entry}); if(-f $entry){ do $entry; warn "package $d load failed: $@" if $@ } } } closedir $dh; }

# ---------------- builtins ----------------
sub builtin_help {
    say color('=' x 60, "1;35");
    say color("prsh $PRSH_VERSION - Builtin Commands", "1;33");
    printf "%s\n", color(sprintf("%-18s%-42s", "Command","Description"), "1;36");
    say color('-' x 60, "1;34");
    printf "%s\n", color(sprintf("%-18s", "cd"), "1;36") . "Change directory";
    printf "%s\n", color(sprintf("%-18s", "pwd"), "1;36") . "Print working directory";
    printf "%s\n", color(sprintf("%-18s", "exit / quit"), "1;36") . "Exit the shell";
    printf "%s\n", color(sprintf("%-18s", "alias"), "1;36") . "Create or list aliases";
    printf "%s\n", color(sprintf("%-18s", "unalias"), "1;36") . "Remove alias";
    printf "%s\n", color(sprintf("%-18s", "jobs"), "1;36") . "Show background jobs (tracked pids)";
    printf "%s\n", color(sprintf("%-18s", "systemfetch"), "1;36") . "Display system information (includes package count)";
    printf "%s\n", color(sprintf("%-18s", "uptime"), "1;36") . "Show system uptime";
    printf "%s\n", color(sprintf("%-18s", "hist"), "1;36") . "Show shell history";
    printf "%s\n", color(sprintf("%-18s", "clearhist"), "1;36") . "Clear saved history (memory + file)";
    printf "%s\n", color(sprintf("%-18s", "togglehint"), "1;36") . "Toggle persistent readline hint on/off";
    printf "%s\n", color(sprintf("%-18s", "pkg"), "1;36") . "Package manager: install/list/remove/enable/disable/update/info";
    printf "%s\n", color(sprintf("%-18s", "help"), "1;36") . "Show this help message";
    say color('=' x 60, "1;35");
}

sub builtin_systemfetch {
    my $user = $ENV{USER} || getpwuid($<) || 'unknown';
    my $host = hostname();
    my $os = detect_distro();
    my $perl_ver = $^V;
    my @p1 = read_cpu_times(); sleep 0.05; my @p2 = read_cpu_times();
    my $cpu_percent = 0; eval { $cpu_percent = sprintf("%.1f", calculate_cpu_usage(\@p1,\@p2)) }; $cpu_percent = 0 if $@;
    my $mem_percent = 0;
    if (-f '/proc/meminfo') {
        my %m; open my $fh,'<','/proc/meminfo'; while (<$fh>) { if (/^(\S+):\s+(\d+)/) { $m{$1} = $2 * 1024 } } close $fh;
        my $total = $m{MemTotal} || 1; my $avail = $m{MemAvailable} || $m{MemFree} || 0; my $used = $total - $avail;
        $mem_percent = sprintf("%.1f", ($used/$total*100));
    }
    my ($pm,$count,$note) = detect_pkg_manager_and_count();
    say color('=' x 60, "1;35");
    say color("prsh System Information", "1;33");
    say color("User:        ", "1;36") . color("$user\@$host", "0;37");
    say color("OS:          ", "1;36") . color($os, "0;37");
    say color("Shell:       ", "1;36") . color("prsh $PRSH_VERSION", "0;37");
    say color("Perl:        ", "1;36") . color("$perl_ver", "0;37");
    say color("CPU Usage:   ", "1;36") . nice_bar($cpu_percent, 30, 32);
    say color("RAM Usage:   ", "1;36") . nice_bar($mem_percent, 30, 35);
    if ($pm ne 'unknown') { say color("Packages:     ", "1;36") . color("$count", "0;37") . " " . color("($note)", "0;90"); }
    else { say color("Packages:     ", "1;36") . color("Unknown package manager", "31") . " " . color("(tried dpkg/rpm/pacman/apk/pkg/flatpak/snap)", "90"); }
    say color("Storage:      ", "1;36") . color(storage_info(), "0;37");
    say color('=' x 60, "1;35");
}

sub builtin_jobs {
    if (!@child_pids) { say color("No tracked child jobs.", 36); return; }
    for my $pgid (@child_pids) {
        my $status = (kill 0, $pgid) ? 'running' : 'done';
        say "[$pgid] $status";
    }
}

sub builtin_hist {
    my $i = 0;
    if ($has_get_history) {
        my $h_ref = eval { $term->get_history };
        if ($h_ref && ref($h_ref) eq 'ARRAY') { for my $h (@$h_ref) { printf "%5d  %s\n", ++$i, $h } return }
    }
    if (@own_history) { for my $h (@own_history) { printf "%5d  %s\n", ++$i, $h } return }
    if (-f $HISTORY_FILE) { if (open my $hf,'<:encoding(UTF-8)',$HISTORY_FILE) { while (my $line = <$hf>) { chomp $line; printf "%5d  %s\n", ++$i, $line } close $hf; return } }
}

sub builtin_clearhist {
    @own_history = ();
    if (-f $HISTORY_FILE) {
        unlink $HISTORY_FILE or warn "Could not remove history file '$HISTORY_FILE': $!";
    }
    eval {
        if ($term) {
            if ($term->can('clear_history')) {
                eval { $term->clear_history(); 1 };
            }
            my $attribs = eval { $term->Attribs };
            if ($attribs && ref($attribs) eq 'HASH') {
                $attribs->{history} = [] if exists $attribs->{history};
            }
        }
    };
    say color("History cleared (memory + file).", 32);
}

sub builtin_togglehint {
    $config{hide_readline_hint} = $config{hide_readline_hint} ? 0 : 1;
    write_config();
    say color("Persistent readline hint is now " . ($config{hide_readline_hint} ? "OFF" : "ON") . ".", 36);
}

sub builtin_toggleconfirmexit {
    $config{confirm_exit} = $config{confirm_exit} ? 0 : 1;
    write_config();
    say color("Confirm-on-exit is now " . ($config{confirm_exit} ? "ON" : "OFF") . ".", 36);
}

sub builtin_togleconfirmexit { builtin_toggleconfirmexit(); }

sub builtin_uptime {
    if (-f '/proc/uptime') {
        open my $fh,'<','/proc/uptime';
        my $line = <$fh>;
        close $fh;
        if ($line =~ /^(\d+\.\d+)/) {
            my $s = int($1); my $d = int($s/86400); $s %= 86400; my $h = int($s/3600); $s %= 3600; my $m = int($s/60);
            say "Uptime: ${d} days, ${h} hours, ${m} minutes"; return;
        }
    }
    my $out = qx(uptime 2>/dev/null);
    say $out ? $out : "Uptime info not available";
}

# ---------------- PTY helpers & run_external ----------------
use constant TIOCGWINSZ => eval { require 'sys/ioctl.ph'; &TIOCGWINSZ } || 0x5413;
use constant TIOCSWINSZ => eval { require 'sys/ioctl.ph'; &TIOCSWINSZ } || 0x5414;

sub set_winsize_for_pty {
    my ($pty) = @_;
    return unless $pty;
    my $out_fd = fileno($OUT) // fileno(STDOUT);
    my $buf = pack("S S S S", 0,0,0,0);
    if (defined $out_fd && ioctl($out_fd, &TIOCGWINSZ, $buf)) {
        my ($rows,$cols,$xp,$yp) = unpack("S S S S", $buf);
        my $packed = pack("S S S S", $rows,$cols,$xp,$yp);
        my $pty_fd = eval { $pty->fileno };
        ioctl($pty_fd, &TIOCSWINSZ, $packed) if defined $pty_fd;
    }
}

sub run_external {
    my ($line,$stdin_file,$stdout_file,$append) = @_;
    my @args = shell_split($line);
    return unless @args;

    if (defined $stdin_file || defined $stdout_file) {
        return _run_external_fork_exec($line,$stdin_file,$stdout_file,$append);
    }

    my $have_pty = eval { require IO::Pty; IO::Pty->import(); 1 };
    unless ($have_pty) { return _run_external_fork_exec($line,$stdin_file,$stdout_file,$append) }

    my $pty = eval { IO::Pty->new() };
    unless ($pty) { return _run_external_fork_exec($line,$stdin_file,$stdout_file,$append) }

    my $pid = fork();
    if (!defined $pid) { say color("Failed to fork",31); return }
    if ($pid == 0) {
        setsid();
        my $slave = $pty->slave();
        my $sfd = $slave->fileno;
        POSIX::dup2($sfd, fileno(STDIN));
        POSIX::dup2($sfd, fileno(STDOUT));
        POSIX::dup2($sfd, fileno(STDERR));
        $pty->close;
        $SIG{INT} = 'DEFAULT';
        CORE::exec $args[0], @args[1..$#args];
        POSIX::_exit(127);
    } else {
        push @child_pids, $pid;
        set_winsize_for_pty($pty);
        local $SIG{WINCH} = sub { set_winsize_for_pty($pty) };
        local $SIG{INT} = 'IGNORE';

        my $oldmode = Term::ReadKey::ReadMode(4);
        my $sel = IO::Select->new();
        $sel->add($pty);
        $sel->add(\*STDIN);
        my $ok = 1;
        eval {
            while ($ok) {
                my @ready = $sel->can_read(0.25);
                for my $fh (@ready) {
                    if (defined(fileno($fh)) && defined(eval { $pty->fileno }) && fileno($fh) == eval { $pty->fileno }) {
                        my $buf = '';
                        my $n = sysread($pty, $buf, 4096);
                        if (!defined $n || $n == 0) { $ok = 0; last }
                        syswrite($OUT, $buf);
                    } else {
                        my $in = '';
                        my $n = sysread(STDIN, $in, 4096);
                        if (!defined $n || $n == 0) { $ok = 0; last }
                        syswrite($pty, $in);
                    }
                }
            }
        };
        Term::ReadKey::ReadMode($oldmode);
        waitpid($pid, 0);
        my $exit = $? >> 8;
        @child_pids = grep { $_ != $pid } @child_pids;
        $pty->close if $pty;
        if ($exit == 127) { say color("Command not found: $args[0]", random_color()) }
    }
}

sub _run_external_fork_exec {
    my ($line,$stdin_file,$stdout_file,$append) = @_;
    my @args = shell_split($line);
    return unless @args;
    my $pid = fork();
    if (!defined $pid) { say color("Failed to fork",31); return }
    if ($pid == 0) {
        $SIG{INT} = 'DEFAULT';
        if (defined $stdin_file) { open STDIN,'<',$stdin_file or POSIX::_exit(1) }
        if (defined $stdout_file) {
            if ($append) { open STDOUT,'>>',$stdout_file or POSIX::_exit(1) }
            else { open STDOUT,'>',$stdout_file or POSIX::_exit(1) }
        }
        if (open my $nullfh, '>', '/dev/null') { POSIX::dup2(fileno($nullfh), fileno(STDERR)); }
        CORE::exec $args[0], @args[1..$#args];
        POSIX::_exit(127);
    } else {
        push @child_pids, $pid;
        waitpid($pid,0);
        my $exit = $? >> 8;
        @child_pids = grep { $_ != $pid } @child_pids;
        if ($exit == 127) { say color("Command not found: $args[0]", random_color()) }
    }
}

# ---------------- command dispatch ----------------
sub parse_redirection {
    my ($cmd) = @_;
    my ($stdin_file,$stdout_file,$append) = (undef,undef,0);
    if ($cmd =~ /(.*)>>\s*(\S+)\s*$/) { $cmd = $1; $stdout_file = $2; $append = 1 }
    elsif ($cmd =~ /(.*)>\s*(\S+)\s*$/) { $cmd = $1; $stdout_file = $2 }
    if ($cmd =~ /(.*)<\s*(\S+)\s*$/) { $cmd = $1; $stdin_file = $2 }
    $cmd =~ s/\s+$//;
    return ($cmd,$stdin_file,$stdout_file,$append);
}

sub run_command {
    my ($cmd) = @_;
    return unless defined $cmd;
    $cmd =~ s/^\s+|\s+$//g; return if $cmd eq '';
    $cmd = expand_aliases($cmd);
    $cmd = expand_vars($cmd);
    my ($core,$stdin,$stdout,$append) = parse_redirection($cmd);
    my @args = shell_split($core);
    return unless @args;

    if ($args[0] eq 'cd') {
        my $path = $args[1] // home_dir();
        if (! -e $path) { say color("cd: no such file or directory: $path",31); return }
        if (! -d $path) { say color("cd: not a directory: $path",31); return }
        chdir $path or say color("cd: $!",31);
        return;
    }
    if ($args[0] eq 'exit' || $args[0] eq 'quit') {
        if ($config{confirm_exit}) {
            print color("Do you really wanna leave me? (y/n) ",35);
            my $ans = <STDIN>;
            if (defined $ans) { chomp $ans; if ($ans =~ /^(y|yes)$/i) { say color("Bye! Take care!",36); kill 'TERM', $_ for @child_pids; exit 0 } else { return } } else { exit 0 }
        } else {
            say color("Bye! Take care!",36);
            kill 'TERM', $_ for @child_pids;
            exit 0;
        }
    }
    if ($args[0] eq 'alias') {
        if (!defined $args[1]) { while (my ($k,$v) = each %aliases) { say "$k='$v'" } }
        else { my $rest = join ' ', @args[1..$#args]; if ($rest =~ /^(\w+)=(['"]?)(.+?)\2$/) { $aliases{$1} = $3 } else { say color("Invalid alias format. Use: alias name='command'",31) } }
        return;
    }
    if ($args[0] eq 'unalias') { if ($args[1]) { delete $aliases{$args[1]} } else { say color("unalias: usage: unalias name",31) } return }
    if ($args[0] eq 'help') { builtin_help(); return }
    if ($args[0] eq 'systemfetch') { builtin_systemfetch(); return }
    if ($args[0] eq 'jobs') { builtin_jobs(); return }
    if ($args[0] eq 'pwd') { say color(Cwd::getcwd(),36); return }
    if ($args[0] eq 'hist') { builtin_hist(); return }
    if ($args[0] eq 'clearhist') { builtin_clearhist(); return }
    if ($args[0] eq 'togglehint') { builtin_togglehint(); return }
    if ($args[0] eq 'toggleconfirmexit') { builtin_toggleconfirmexit(); return }
    if ($args[0] eq 'togleconfirmexit') { builtin_toggleconfirmexit(); return }
    if ($args[0] eq 'uptime') { builtin_uptime(); return }

    if ($args[0] eq 'pkg') {
        my $sub = $args[1] // '';
        if ($sub eq 'install') {
            if (defined $args[2] && $args[2] eq '--system') { pkg_install_system($args[3]); return }
            my $src = $args[2];
            unless ($src) { say color("Usage: pkg install [--system] <git_url|local_dir>",31); return }
            if ($src =~ m{^(?:https?://|git://)|\.git$|^git@}) { pkg_install_git($src); return }
            if (-d $src) { pkg_install_local($src); return }
            say color("Unknown install source. Use a git URL or a local directory, or use --system for system packages.",31);
            return;
        } elsif ($sub eq 'list') { pkg_list(); return }
        elsif ($sub eq 'remove') { pkg_remove($args[2]); return }
        elsif ($sub eq 'enable') { pkg_enable($args[2]); return }
        elsif ($sub eq 'disable') { pkg_disable($args[2]); return }
        elsif ($sub eq 'update') { pkg_update($args[2] // '--all'); return }
        elsif ($sub eq 'info') { pkg_info($args[2]); return }
        else { say color("pkg subcommands: install/list/remove/enable/disable/update/info",33); return }
    }

    if (scalar(@args) == 1 && -d $args[0]) {
        chdir $args[0] or say color("cd: $!",31);
        return;
    }

    if ($args[0] =~ m{[/\\]} || $args[0] =~ /^\./) { if (-d $args[0]) { say color("prsh: $args[0]: is a directory",31); return } }

    run_external($core,$stdin,$stdout,$append);
}

sub run_input_line {
    my ($input) = @_;
    my @parts = split /(?:&&|;)/, $input;
    for my $p (@parts) { $p =~ s/^\s+|\s+$//g; next unless $p; run_command($p) }
}

my $hostname = hostname();
my $prompt_color = random_color();
sub prompt { my $cwd = Cwd::getcwd(); return color($cwd,33) . " " . color($hostname,36) . color(' > ', $prompt_color) }

sub running_under_rlwrap {
    my $ppid = getppid();
    return 0 unless $ppid;
    my $proc = "/proc/$ppid/cmdline";
    if (-r $proc) {
        if (open my $fh,'<',$proc) { my $cmd = do { local $/; <$fh> }; close $fh; return 1 if defined $cmd && $cmd =~ /rlwrap/ }
    }
    return 0;
}

if ($term->can('Attribs')) {
    my $attribs = $term->Attribs;
    eval {
        $attribs->{completion_entry_function} = sub {
            my ($text,$state) = @_;
            state @matches = ();
            if ($state == 0) {
                @matches = _collect_completions($text);
            }
            return $matches[$state];
        };
    };
}

sub print_welcome {
    say color("Welcome to prsh $PRSH_VERSION - your Perl-ish shell!",36);
    say color("Current Time:",36) . " " . color(current_time(),34);
    say cpu_info();
    say ram_info();
    say storage_info();
    say dynamic_quote();
    say "";
    if (! $config{hide_readline_hint}) {
        if (ref($term) =~ /Stub/ && ! running_under_rlwrap()) {
            say color("Note: Readline backend looks minimal; fallback editor active.", "1;33");
            say color("Arrow-up/down populate history; install Term::ReadLine::Gnu or use 'rlwrap ./prsh' for full editing.", "0;37");
            say "";
        }
    }
    say color("Coded with ❤",90);
    say color("GitHub: $GITHUB",90);
    say "";
}

load_enabled_packages();
print_welcome();

while (1) {
    print "\033]0;prsh-$PRSH_VERSION\007";
    my $line = $term->readline(prompt());
    unless (defined $line) { say ""; last }
    $line =~ s/^\s+|\s+$//g;
    next if $line eq '';
    push @own_history, $line unless @own_history && $own_history[-1] eq $line;
    eval { $term->addhistory($line) } if $has_addhistory;
    run_input_line($line);
}

exit 0;
