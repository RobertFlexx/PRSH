# ---------------- PTY helpers & run_external ----------------
use constant TIOCGWINSZ => eval { require 'sys/ioctl.ph'; &TIOCGWINSZ } || 0x5413;
use constant TIOCSWINSZ => eval { require 'sys/ioctl.ph'; &TIOCSWINSZ } || 0x5414;

sub set_winsize_for_pty {
    my ($pty) = @_;
    return unless $pty;
    my $out_fd = fileno($OUT) // fileno(STDOUT);
    my $buf = pack("S S S S", 0,0,0,0);
    if (defined $out_fd && ioctl($out_fd, &TIOCGWINSZ, $buf)) {
        my ($rows,$cols,$xp,$yp) = unpack("S S S S", $buf);
        my $packed = pack("S S S S", $rows,$cols,$xp,$yp);
        my $pty_fd = eval { $pty->fileno };
        ioctl($pty_fd, &TIOCSWINSZ, $packed) if defined $pty_fd;
    }
}

sub run_external {
    my ($line,$stdin_file,$stdout_file,$append) = @_;
    my @args = shell_split($line);
    return unless @args;

    if (defined $stdin_file || defined $stdout_file) {
        return _run_external_fork_exec($line,$stdin_file,$stdout_file,$append);
    }

    my $have_pty = eval { require IO::Pty; IO::Pty->import(); 1 };
    unless ($have_pty) { return _run_external_fork_exec($line,$stdin_file,$stdout_file,$append) }

    my $pty = eval { IO::Pty->new() };
    unless ($pty) { return _run_external_fork_exec($line,$stdin_file,$stdout_file,$append) }

    my $pid = fork();
    if (!defined $pid) { say color("Failed to fork",31); return }
    if ($pid == 0) {
        setsid();
        my $slave = $pty->slave();
        my $sfd = $slave->fileno;
        POSIX::dup2($sfd, fileno(STDIN));
        POSIX::dup2($sfd, fileno(STDOUT));
        POSIX::dup2($sfd, fileno(STDERR));
        $pty->close;
        $SIG{INT} = 'DEFAULT';
        CORE::exec $args[0], @args[1..$#args];
        POSIX::_exit(127);
    } else {
        push @child_pids, $pid;
        set_winsize_for_pty($pty);
        local $SIG{WINCH} = sub { set_winsize_for_pty($pty) };
        local $SIG{INT} = 'IGNORE';

        my $oldmode = Term::ReadKey::ReadMode(4);  # raw, no echo
        my $sel = IO::Select->new();
        $sel->add($pty);
        $sel->add(\*STDIN);
        my $ok = 1;
        eval {
            while ($ok) {
                my @ready = $sel->can_read(0.25);
                for my $fh (@ready) {
                    if (defined(fileno($fh)) && defined(eval { $pty->fileno }) && fileno($fh) == eval { $pty->fileno }) {
                        my $buf = '';
                        my $n = sysread($pty, $buf, 4096);
                        if (!defined $n || $n == 0) { $ok = 0; last }
                        syswrite($OUT, $buf);
                    } else {
                        my $in = '';
                        my $n = sysread(STDIN, $in, 4096);
                        if (!defined $n || $n == 0) { $ok = 0; last }
                        syswrite($pty, $in);
                    }
                }
            }
        };
        Term::ReadKey::ReadMode($oldmode);
        waitpid($pid, 0);
        my $exit = $? >> 8;
        @child_pids = grep { $_ != $pid } @child_pids;
        $pty->close if $pty;
        if ($exit == 127) { say color("Command not found: $args[0]", random_color()) }
    }
}

sub _run_external_fork_exec {
    my ($line,$stdin_file,$stdout_file,$append) = @_;
    my @args = shell_split($line);
    return unless @args;
    my $pid = fork();
    if (!defined $pid) { say color("Failed to fork",31); return }
    if ($pid == 0) {
        $SIG{INT} = 'DEFAULT';
        if (defined $stdin_file)  { open STDIN,'<',$stdin_file  or POSIX::_exit(1) }
        if (defined $stdout_file) {
            if ($append) { open STDOUT,'>>',$stdout_file or POSIX::_exit(1) }
            else         { open STDOUT,'>' ,$stdout_file or POSIX::_exit(1) }
        }
        if (open my $nullfh, '>', '/dev/null') { POSIX::dup2(fileno($nullfh), fileno(STDERR)); }
        CORE::exec $args[0], @args[1..$#args];
        POSIX::_exit(127);
    } else {
        push @child_pids, $pid;
        waitpid($pid,0);
        my $exit = $? >> 8;
        @child_pids = grep { $_ != $pid } @child_pids;
        if ($exit == 127) { say color("Command not found: $args[0]", random_color()) }
    }
}

# ---------------- command dispatch ----------------
sub parse_redirection {
    my ($cmd) = @_;
    my ($stdin_file,$stdout_file,$append) = (undef,undef,0);
    if ($cmd =~ /(.*)>>\s*(\S+)\s*$/) { $cmd = $1; $stdout_file = $2; $append = 1 }
    elsif ($cmd =~ /(.*)>\s*(\S+)\s*$/) { $cmd = $1; $stdout_file = $2 }
    if ($cmd =~ /(.*)<\s*(\S+)\s*$/) { $cmd = $1; $stdin_file = $2 }
    $cmd =~ s/\s+$//;
    return ($cmd,$stdin_file,$stdout_file,$append);
}

sub run_command {
    my ($cmd) = @_;
    return unless defined $cmd;
    $cmd =~ s/^\s+|\s+$//g; return if $cmd eq '';
    $cmd = expand_aliases($cmd);
    $cmd = expand_vars($cmd);
    my ($core,$stdin,$stdout,$append) = parse_redirection($cmd);
    my @args = shell_split($core);
    return unless @args;

    if ($args[0] eq 'cd') {
        my $path = $args[1] // home_dir();
        if (! -e $path) { say color("cd: no such file or directory: $path",31); return }
        if (! -d $path) { say color("cd: not a directory: $path",31); return }
        chdir $path or say color("cd: $!",31);
        return;
    }
    if ($args[0] eq 'exit' || $args[0] eq 'quit') {
        if ($config{confirm_exit}) {
            print color("Do you really wanna leave me? (y/n) ",35);
            my $ans = <STDIN>;
            if (defined $ans) { chomp $ans; if ($ans =~ /^(y|yes)$/i) { say color("Bye! Take care!",36); kill 'TERM', $_ for @child_pids; exit 0 } else { return } } else { exit 0 }
        } else {
            say color("Bye! Take care!",36);
            kill 'TERM', $_ for @child_pids;
            exit 0;
        }
    }
    if ($args[0] eq 'alias') {
        if (!defined $args[1]) { while (my ($k,$v) = each %aliases) { say "$k='$v'" } }
        else { my $rest = join ' ', @args[1..$#args]; if ($rest =~ /^(\w+)=(['"]?)(.+?)\2$/) { $aliases{$1} = $3 } else { say color("Invalid alias format. Use: alias name='command'",31) } }
        return;
    }
    if ($args[0] eq 'unalias') { if ($args[1]) { delete $aliases{$args[1]} } else { say color("unalias: usage: unalias name",31) } return }
    if ($args[0] eq 'help') { builtin_help(); return }
    if ($args[0] eq 'systemfetch') { builtin_systemfetch(); return }
    if ($args[0] eq 'jobs') { builtin_jobs(); return }
    if ($args[0] eq 'pwd') { say color(Cwd::getcwd(),36); return }
    if ($args[0] eq 'hist') { builtin_hist(); return }
    if ($args[0] eq 'clearhist') { builtin_clearhist(); return }
    if ($args[0] eq 'togglehint') { builtin_togglehint(); return }
    if ($args[0] eq 'toggleconfirmexit') { builtin_toggleconfirmexit(); return }
    if ($args[0] eq 'togleconfirmexit') { builtin_toggleconfirmexit(); return }
    if ($args[0] eq 'uptime') { builtin_uptime(); return }

    # New 'neutron' command
    if ($args[0] eq 'neutron') {
        my @a = @args;
        shift @a; # remove 'neutron'
        my $system_flag = 0;
        for my $i (0..$#a) {
            if (defined $a[$i] && $a[$i] eq '--system') { $system_flag = 1; splice(@a,$i,1); last }
        }
        my $sub = $a[0] // '';
        if ($sub eq '-S') {
            my $src = $a[1];
            unless ($src) { say color("Usage: neutron -S <git_url|local_dir|pkgname> OR neutron -S --system <name>",31); return }
            if ($src =~ m{^(?:https?://|git://)|\.git$|^git@}) {
                pkg_install_git($src, $system_flag); return;
            }
            if (-d $src) { pkg_install_local($src, $system_flag); return; }
            my $mgr = detect_system_pkg();
            if ($mgr && !$system_flag) {
                print color(":: ",35) . "Detected system package manager ($mgr). Install '$src' system-wide? [Y/n] ";
                my $ans = <STDIN>;
                chomp $ans if defined $ans; $ans //= '';
                if ($ans eq '' || $ans =~ /^y/i) { pkg_install_system($src); return; }
                else {
                    my $try = "https://github.com/$src.git";
                    say color(":: ",35) . "Trying to fetch from $try ...";
                    pkg_install_git($try, 0); return;
                }
            }
            if (-d File::Spec->catdir($PRSH_PKG_ROOT,$src)) {
                pkg_install_local(File::Spec->catdir($PRSH_PKG_ROOT,$src), $system_flag); return;
            } else {
                my $try = "https://github.com/$src.git";
                say color(":: ",35) . "Trying to fetch from $try ...";
                pkg_install_git($try, $system_flag); return;
            }
        }
        elsif ($sub eq '--update') { my $maybe = $a[1]; pkg_update($maybe // '--all'); return }
        elsif ($sub eq '--info')   { pkg_info($a[1]); return }
        elsif ($sub eq '--list')   { pkg_list(); return }
        elsif ($sub eq 'uninstall' || $sub eq 'remove') { pkg_remove($a[1]); return }
        elsif ($sub eq 'enable')   { pkg_enable($a[1]); return }
        elsif ($sub eq 'disable')  { pkg_disable($a[1]); return }
        else {
            say color("neutron subcommands: -S/--update/--info/--list/uninstall/enable/disable",33);
            say color("Try 'help' for more info.",90);
            return;
        }
    }

    # AUTOCD: if a single arg is a directory, cd into it
    if (scalar(@args) == 1 && -d $args[0]) {
        chdir $args[0] or say color("cd: $!",31);
        return;
    }

    if ($args[0] =~ m{[/\\]} || $args[0] =~ /^\./) { if (-d $args[0]) { say color("prsh: $args[0]: is a directory",31); return } }

    run_external($core,$stdin,$stdout,$append);
}

# ---------------- chained commands ----------------
sub run_input_line {
    my ($input) = @_;
    my @parts = split /(?:&&|;)/, $input;
    for my $p (@parts) { $p =~ s/^\s+|\s+$//g; next unless $p; run_command($p) }
}

# ---------------- prompt & readline helpers ----------------
my $hostname = hostname();
my $prompt_color = random_color();
sub prompt { my $cwd = Cwd::getcwd(); return color($cwd,33) . " " . color($hostname,36) . color(' > ', $prompt_color) }

sub running_under_rlwrap {
    my $ppid = getppid();
    return 0 unless $ppid;
    my $proc = "/proc/$ppid/cmdline";
    if (-r $proc) {
        if (open my $fh,'<',$proc) { my $cmd = do { local $/; <$fh> }; close $fh; return 1 if defined $cmd && $cmd =~ /rlwrap/ }
    }
    return 0;
}

# ---------------- improved my_readline (from txt; arrows + Ctrl-C) ----------------
sub my_readline {
    my ($prompt_text) = @_;
    $prompt_text //= '';
    my $under_rlwrap = running_under_rlwrap();

    my $have_readline_backend = ($term && $term->can('readline'));
    my $is_stub_backend = ($rl_backend =~ /stub/i || $rl_backend =~ /Perl::Stub/i || $rl_backend =~ /Term::ReadLine::Stub/i);

    if ($have_readline_backend && (!$is_stub_backend || $under_rlwrap)) {
        my $attribs = eval { $term->Attribs };
        if ($attribs && ref($attribs) eq 'HASH') { $attribs->{catch_signals} = 0; }
        my $line;
        eval {
            local $SIG{INT} = sub { die "INT\n" };
            $line = $term->readline($prompt_text);
        };
        if ($@) {
            if ($@ =~ /INT/) { print $OUT "^C\n"; return '' }
            return undef;
        }
        return $line;
    }

    my ($rows, $cols) = Term::ReadKey::GetTerminalSize();
    $cols ||= 80;

    my $prompt_vis = visible_length($prompt_text);
    my $display_prompt = $prompt_text;

    my $available = $cols - $prompt_vis;
    $available = 10 if $available < 10;

    my $offset = 0;
    my $line = "";
    my $pos = 0;
    my $hist_index = scalar(@own_history);

    my $ensure_offset_for_pos = sub {
        my ($p) = @_;
        $p = $pos unless defined $p;
        my $len = length($line);
        my ($r,$c) = Term::ReadKey::GetTerminalSize();
        $cols = $c || $cols;
        $prompt_vis = visible_length($display_prompt);
        $available = $cols - $prompt_vis;
        $available = 10 if $available < 10;

        if ($len <= $available) { $offset = 0; return; }
        my $last_index_visible = $available - 1;
        if ($p - $offset > $last_index_visible) { $offset = $p - $last_index_visible; }
        if ($offset > $len - $available) { $offset = $len - $available; }
        $offset = 0 if $offset < 0;
        if ($p < $offset) { $offset = $p; }
    };

    my $redraw = sub {
        $line //= '';
        my $len = length($line);
        $offset = 0 if $offset < 0;
        $offset = 0 if $len == 0;
        if ($offset > $len) { $offset = $len > 0 ? $len - 1 : 0 }
        my $visible = $len ? substr($line, $offset, $available) : '';
        $visible = '' unless defined $visible;
        if ($offset > 0) { substr($visible, 0, 1, "…") if length($visible) >= 1 }
        if ($offset + $available < $len) { substr($visible, -1, 1, "…") if length($visible) >= 1 }
        my $cursor_in_visible = $pos - $offset;
        $cursor_in_visible = 0 if $cursor_in_visible < 0;
        $cursor_in_visible = length($visible) if $cursor_in_visible > length($visible);
        print $OUT "\e[?7l";
        print $OUT "\r\e[0J";
        print $OUT $display_prompt;
        print $OUT $visible;
        print $OUT "\r";
        my $cursor_col = $prompt_vis + $cursor_in_visible;
        print $OUT "\e[${cursor_col}C" if $cursor_col > 0;
        print $OUT "\e[?7h";
    };

    local $SIG{WINCH} = sub {
        my ($r,$c) = Term::ReadKey::GetTerminalSize();
        $cols = $c || $cols;
        $available = $cols - $prompt_vis;
        $available = 10 if $available < 10;
        $ensure_offset_for_pos->($pos);
        $redraw->();
    };

    local $SIG{INT} = sub { $interrupted = 1 };

    print $OUT $display_prompt;
    Term::ReadKey::ReadMode('cbreak');

    my $sel = IO::Select->new();
    $sel->add(\*STDIN);

    eval {
        while (1) {
            if ($interrupted) {
                $interrupted = 0;
                Term::ReadKey::ReadMode('normal');
                print $OUT "^C\n";
                return '';
            }
            my @ready = $sel->can_read(0.08);
            unless (@ready) { next }

            my $key = ReadKey(-1);
            defined $key or next;

            # Tab completion
            if ($key eq "\t") {
                my ($pre, $word) = ('', $line);
                if ($line =~ /^(.*\s)(\S*)$/s) { $pre = $1; $word = $2; }
                my @matches = _collect_completions($word);
                if (!@matches) {
                    # nothing
                } elsif (@matches == 1) {
                    my $m = $matches[0];
                    my $suffix = substr($m, length($word));
                    if (-d $m && $m !~ m{/\$}) { $suffix .= '/' unless $suffix =~ m{/\$} }
                    my $new = $pre . $word . $suffix;
                    if (!(-d $m)) { $new .= ' ' unless $new =~ /\s$/ }
                    $line = $new;
                    $pos = length($line);
                    $ensure_offset_for_pos->($pos);
                    $redraw->();
                } else {
                    Term::ReadKey::ReadMode('normal');
                    print $OUT "\n";
                    for my $m (@matches) { print $OUT "$m\n" }
                    print $OUT "\n";
                    ($rows, $cols) = Term::ReadKey::GetTerminalSize();
                    $cols ||= 80;
                    $prompt_vis = visible_length($display_prompt);
                    $available = $cols - $prompt_vis;
                    $available = 10 if $available < 10;
                    Term::ReadKey::ReadMode('cbreak');
                    $redraw->();
                }
                next;
            }

            # Enter
            if ($key eq "\n" || $key eq "\r") {
                print $OUT "\n";
                last;
            }

            # Backspace / Delete
            if ($key eq "\x7f" || $key eq "\x08") {
                if ($pos > 0) {
                    substr($line, $pos-1, 1, '');
                    $pos--;
                    $ensure_offset_for_pos->($pos);
                    $redraw->();
                }
                next;
            }

            # Escape sequences (arrows, delete, etc.)
            if ($key eq "\e") {
                my $b = ReadKey(-1);
                if (defined $b && $b eq '[') {
                    my $c = ReadKey(-1);
                    if (defined $c) {
                        if ($c eq 'A') { # up
                            if ($hist_index > 0) {
                                $hist_index--;
                                $line = $own_history[$hist_index] // '';
                                $pos = length($line);
                                $ensure_offset_for_pos->($pos);
                                $redraw->();
                            }
                        } elsif ($c eq 'B') { # down
                            if ($hist_index < @own_history - 1) {
                                $hist_index++;
                                $line = $own_history[$hist_index] // '';
                                $pos = length($line);
                                $ensure_offset_for_pos->($pos);
                            } else {
                                $hist_index = @own_history;
                                $line = '';
                                $pos = 0;
                                $offset = 0;
                            }
                            $redraw->();
                        } elsif ($c eq 'C') { # right
                            if ($pos < length($line)) { $pos++ }
                            $ensure_offset_for_pos->($pos);
                            $redraw->();
                        } elsif ($c eq 'D') { # left
                            if ($pos > 0) { $pos-- }
                            if ($pos < $offset) { $offset = $pos }
                            $redraw->();
                        } else {
                            if ($c eq '3') {
                                my $t = ReadKey(-1);
                                if (defined $t && $t eq '~') {
                                    if ($pos < length($line)) {
                                        substr($line, $pos, 1, '');
                                        $redraw->();
                                    }
                                }
                            }
                        }
                    }
                }
                next;
            }

            # Printable characters
            if ($key =~ /^[\x20-\x7e]$/) {
                substr($line, $pos, 0, $key);
                $pos++;
                $ensure_offset_for_pos->($pos);
                $redraw->();
                next;
            }
        }
    };
    Term::ReadKey::ReadMode('normal');

    return $line;
}

# ---------------- completion (readline) ----------------
if ($term->can('Attribs')) {
    my $attribs = $term->Attribs;
    eval {
        $attribs->{completion_entry_function} = sub {
            my ($text,$state) = @_;
            state @matches = ();
            if ($state == 0) {
                @matches = _collect_completions($text);
            }
            return $matches[$state];
        };
    };
}

# ---------------- welcome ----------------
sub print_welcome {
    say color("Welcome to prsh $PRSH_VERSION - your Perl-ish shell!",36);
    say color("Current Time:",36) . " " . color(current_time(),34);
    say cpu_info();
    say ram_info();
    say storage_info();
    say dynamic_quote();
    say "";
    if (! $config{hide_readline_hint}) {
        if (ref($term) =~ /Stub/ && ! running_under_rlwrap()) {
            say color("Note: Readline backend looks minimal; fallback editor active.", "1;33");
            say color("Arrow-up/down populate history; install Term::ReadLine::Gnu or use 'rlwrap ./prsh' for full editing (left/right arrow editing too).", "0;37");
            say "";
        } else {
            say color("Readline backend:", "1;33") . " " . color($rl_backend, "0;37");
            say color("Arrow keys (↑/↓ history, ←/→ edit) should work with this backend.", "0;37");
            say "";
        }
    }
    say color("Coded with ❤",90);
    say color("GitHub: $GITHUB",90);
    say "";
}

load_enabled_packages();
print_welcome();

# ---------------- main loop ----------------
while (1) {
    print "\033]0;prsh-$PRSH_VERSION\007";
    my $line = my_readline(prompt());
    unless (defined $line) { say ""; last }
    $line =~ s/^\s+|\s+$//g;
    next if $line eq '';
    push @own_history, $line unless @own_history && $own_history[-1] eq $line;
    eval { $term->addhistory($line) } if $has_addhistory;
    run_input_line($line);
}

exit 0;
