BEGIN {
    $^W = 0;
    $SIG{__WARN__} = sub {
        my $w = shift // '';
        return if $w =~ /_FORTIFY_SOURCE requires compiling with optimization/;
        return if $w =~ /Statement unlikely to be reached/;
        return if $w =~ /Maybe you meant system\(\) when you said exec\(\)/;
        warn $w;
    };
    $| = 1;
}

