my %config = ();
sub load_config {
    %config = ();
    return unless -f $CONFIG_FILE;
    if (open my $cf, '<:encoding(UTF-8)', $CONFIG_FILE) {
        while (<$cf>) {
            chomp;
            next unless /\S/;
            next if /^\s*#/;
            if (/^\s*([^=]+?)\s*=\s*(.*?)\s*$/) {
                $config{$1} = $2;
            }
        }
        close $cf;
    }
}
sub write_config {
    if (open my $cf, '>:encoding(UTF-8)', $CONFIG_FILE) {
        for my $k (sort keys %config) {
            print $cf "$k=$config{$k}\n";
        }
        close $cf;
    }
}
load_config();
$config{hide_readline_hint} = 0 unless defined $config{hide_readline_hint};
$config{confirm_exit} = 1 unless defined $config{confirm_exit};

my $term = Term::ReadLine->new('prsh');

# prefer using the term->OUT handle (some backends provide a separate output filehandle)
my $OUT = eval { $term->OUT } || *STDOUT;
{
    my $oldhandle = select($OUT);
    $| = 1;
    select($oldhandle);
}

# detect backend name (safe eval)
my $rl_backend = '';
eval { $rl_backend = $term->ReadLine // '' };
$rl_backend ||= ref($term) || '';

my $has_addhistory = eval { $term->can('addhistory') } || 0;
my $has_get_history = eval { $term->can('get_history') } || 0;

# If a real Attribs hash exists, try to disable ReadLine catching signals globally.
eval {
    if ($term && $term->can('Attribs')) {
        my $attribs = eval { $term->Attribs };
        if ($attribs && ref($attribs) eq 'HASH') {
            $attribs->{catch_signals} = 0;
            $attribs->{completion_function} = $attribs->{completion_function} if exists $attribs->{completion_function};
        }
    }
};

my $interrupted = 0;

$SIG{INT} = sub {
    if (@child_pids) {
        for my $pgid (@child_pids) {
            kill 'INT', -$pgid;
        }
    } else {
        $interrupted = 1;
    }
};

# ---------------- history load/save ----------------
if (-f $HISTORY_FILE) {
    if (open my $hf, '<:encoding(UTF-8)', $HISTORY_FILE) {
        chomp(my @history = <$hf>);
        close $hf;
        @own_history = @history if @history;
        if ($has_addhistory) {
            eval { $term->addhistory($_) for @history };
        }
    }
}
END {
    eval {
        if ($has_get_history) {
            my $h_ref = eval { $term->get_history };
            if ($h_ref && ref($h_ref) eq 'ARRAY') {
                if (open my $hf, '>:encoding(UTF-8)', $HISTORY_FILE) {
                    for my $entry (@$h_ref) {
                        next unless defined $entry && $entry =~ /\S/;
                        print $hf $entry, "\n";
                    }
                    close $hf;
                }
                return;
            }
        }
        if (@own_history) {
            if (open my $hf, '>:encoding(UTF-8)', $HISTORY_FILE) {
                for my $entry (@own_history) {
                    next unless defined $entry && $entry =~ /\S/;
                    print $hf $entry, "\n";
                }
                close $hf;
            }
        }
    };
}

# ---------------- utilities ----------------
sub color { my ($t,$c)=@_; return "\e[$c"."m$t\e[0m"; }
sub random_color { my @c=(31,32,33,34,35,36,37); return $c[int(rand(@c))]; }
sub rainbow_codes { return (31,33,32,36,34,35,91,93,92,96,94,95) }
sub expand_vars { my ($s)=@_; $s =~ s/\$([a-zA-Z_][a-zA-Z0-9_]*)/(exists $ENV{$1} ? $ENV{$1} : "")/ge; return $s; }
sub shell_split { my ($cmd)=@_; return () unless defined $cmd && $cmd =~ /\S/; return shellwords($cmd); }
sub human_bytes {
    my ($b)=@_;
    return "0 B" unless defined $b && $b>0;
    my @u = qw(B KB MB GB TB);
    my $i = 0;
    my $s = $b + 0.0;
    while ($s > 1024 && $i < $#u) { $s /= 1024; $i++ }
    return sprintf("%.2f %s", $s, $u[$i]);
}
sub nice_bar {
    my ($pct,$w,$code)=@_; $w ||= 30; $code ||= 32;
    $pct = 0 unless defined $pct; $pct = 0 if $pct < 0; $pct = 100 if $pct > 100;
    my $filled = int(($pct/100) * $w + 0.5);
    my $bar = ("█" x $filled) . ("░" x ($w - $filled));
    return color("[$bar]", $code) . " " . color(sprintf("%3d%%", $pct), 37);
}

sub visible_length {
    my ($s) = @_;
    return 0 unless defined $s;
    (my $t = $s) =~ s/\e\[[0-9;]*[mK]//g;
    $t =~ s/\e\[[0-9;]*[A-Za-z]//g;
    return length($t);
}

sub _collect_completions {
    my ($text) = @_;
    $text //= '';
    my @matches;
    if ($text =~ /\//) {
        my ($dir,$prefix) = $text =~ m{^(.*/)?([^/]*)$};
        $dir //= './';
        my $pattern = $dir . ($prefix // '') . '*';
        for my $p (glob($pattern)) {
            push @matches, $p;
        }
    } else {
        for my $p (glob("$text*")) {
            push @matches, $p;
        }
        for my $d (split /:/, $ENV{PATH} // '') {
            next unless -d $d;
            if (opendir my $dh, $d) {
                while (my $f = readdir $dh) {
                    next unless $f =~ /^\Q$text\E/;
                    my $full = File::Spec->catfile($d, $f);
                    if (-x $full) {
                        push @matches, $f;
                    }
                }
                closedir $dh;
            }
        }
    }
    my %seen;
    @matches = grep { !$seen{$_}++ } sort @matches;
    return @matches;
}

sub expand_aliases {
    my ($cmd,$seen)=@_; $seen ||= {};
    return $cmd unless defined $cmd && $cmd =~ /\S/;
    my ($first,$rest) = $cmd =~ /^\s*(\S+)(?:\s+(.*))?$/;
    return $cmd unless defined $first;
    return $cmd if $seen->{$first}++;
    if (exists $aliases{$first}) {
        my $replacement = $aliases{$first};
        my $expanded = expand_aliases($replacement,$seen);
        return defined $rest ? "$expanded $rest" : $expanded;
    }
    return $cmd;
}

