# ---------------- CPU / RAM / storage helpers ----------------
sub read_cpu_times { return () unless -f '/proc/stat'; open my $fh,'<','/proc/stat' or return (); while (<$fh>) { if (/^cpu\s+(.*)/) { close $fh; my @v = map { int($_) } split /\s+/, $1; return @v } } close $fh; return (); }
sub calculate_cpu_usage {
    my (@prev)=@{$_[0]}; my (@cur)=@{$_[1]}; return 0 unless @prev && @cur;
    my $prev_idle = ($prev[3]||0)+($prev[4]||0);
    my $idle = ($cur[3]||0)+($cur[4]||0);
    my $prev_non = ($prev[0]||0)+($prev[1]||0)+($prev[2]||0)+($prev[5]||0)+($prev[6]||0)+($prev[7]||0);
    my $non = ($cur[0]||0)+($cur[1]||0)+($cur[2]||0)+($cur[5]||0)+($cur[6]||0)+($cur[7]||0);
    my $prev_total = $prev_idle + $prev_non; my $total = $idle + $non;
    my $totald = $total - $prev_total; my $idled = $idle - $prev_idle;
    return 0 if $totald <= 0; return (($totald - $idled) / $totald) * 100;
}
sub cpu_info { if (-f '/proc/stat' && -f '/proc/cpuinfo') { my @p1 = read_cpu_times; sleep 0.05; my @p2 = read_cpu_times; my $usage = sprintf("%.1f", calculate_cpu_usage(\@p1,\@p2)); my $cores=0; my @freqs; open my $fh,'<','/proc/cpuinfo'; while (<$fh>) { $cores++ if /^processor\s*:\s*\d+/; push @freqs, sprintf("%.0fMHz",$1) if /^cpu MHz\s*:\s*([\d.]+)/ } close $fh; my $freq_display = @freqs ? join(", ", @freqs[0..($cores-1)]) : "N/A"; return color("CPU Usage:",36)." ".color("$usage%",33)." | ".color("Cores:",36)." ".color($cores,32)." | ".color("Freqs:",36)." ".color($freq_display,35) } return color("CPU Usage:",36)." Info not available" }
sub ram_info { if (-f '/proc/meminfo') { my %m; open my $fh,'<','/proc/meminfo'; while (<$fh>) { if (/^(\S+):\s+(\d+)/) { $m{$1} = $2 * 1024 } } close $fh; my $total = $m{MemTotal} || 0; my $avail = $m{MemAvailable} || $m{MemFree} || 0; my $used = $total - $avail; return color("RAM Usage:",36)." ".color(human_bytes($used),33)." / ".color(human_bytes($total),32) } return color("RAM Usage:",36)." Info not available" }
sub storage_info { my $cwd = Cwd::getcwd(); my $out = qx(df -B1 "$cwd" 2>/dev/null); if ($? == 0 && $out =~ /\S/) { my @lines = split /\n/, $out; my $line = $lines[-1]; my @f = split /\s+/, $line; my ($total, $used) = ($f[1] // 0, $f[2] // 0); return color("Storage Usage ($cwd):",36)." ".color(human_bytes($used),33)." / ".color(human_bytes($total),32) } return color("Storage Usage:",36)." Info not available" }

# ---------------- package counting ----------------
sub which { for my $d (split /:/, $ENV{PATH}) { next unless defined $d && $d ne ''; my $f = File::Spec->catfile($d, $_[0]); return $f if -x $f } return undef }
sub run_and_count_lines { my ($cmd)=@_; my $out = qx($cmd 2>/dev/null); return 0 unless defined $out && $out ne ''; return scalar split /\n/,$out }
sub detect_pkg_manager_and_count {
    if (which('dpkg')) { my $c = run_and_count_lines("dpkg -l | grep -E '^ii\\s' || true"); return ('dpkg',$c,"dpkg (Debian/Ubuntu)"); }
    if (which('rpm')) { my $c = run_and_count_lines('rpm -qa'); return ('rpm',$c,"rpm (RHEL/Fedora/openSUSE)"); }
    if (which('pacman')) { my $c = run_and_count_lines('pacman -Q'); return ('pacman',$c,"pacman (Arch)"); }
    if (which('apk')) { my $c = run_and_count_lines('apk info'); return ('apk',$c,"apk (Alpine)"); }
    if (which('pkg')) { my $c = run_and_count_lines('pkg info'); return ('pkg',$c,"pkg (FreeBSD/Termux)"); }
    if (which('flatpak')) { my $c = run_and_count_lines('flatpak list --app'); return ('flatpak',$c,"flatpak (flatpak apps)"); }
    if (which('snap')) { my $c = run_and_count_lines('snap list'); return ('snap',$c,"snap (snap packages)"); }
    return ('unknown',0,"unknown");
}

# ---------------- simple prsh-local package manager ----------------
my $PRSH_PKG_ROOT   = File::Spec->catdir(home_dir(), ".prsh", "packages");
my $PRSH_LOCAL_BIN  = File::Spec->catdir(home_dir(), ".local", "prsh", "bin");
make_path($PRSH_PKG_ROOT)  unless -d $PRSH_PKG_ROOT;
make_path($PRSH_LOCAL_BIN) unless -d $PRSH_LOCAL_BIN;
$ENV{PATH} = $PRSH_LOCAL_BIN . ':' . ($ENV{PATH} // '');

sub _pkg_meta_file { my ($name) = @_; return File::Spec->catfile($PRSH_PKG_ROOT,$name,"meta.json"); }
sub _read_pkg_meta { my ($name) = @_; my $f = _pkg_meta_file($name); return {} unless -f $f; if(open my $fh,'<:encoding(UTF-8)',$f){ local $/; my $j = <$fh>; close $fh; my $h = eval { decode_json($j) }; return $h && ref($h) eq 'HASH' ? $h : {} } return {}; }
sub _write_pkg_meta { my ($name,$meta) = @_; my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$name); make_path($dir) unless -d $dir; my $f = _pkg_meta_file($name); if(open my $fh,'>:encoding(UTF-8)',$f){ print $fh encode_json($meta); close $fh; return 1 } return 0; }

# Link logic: link bin/ and top-level executables & shebang files
sub _link_package_bins {
    my ($name) = @_;
    my $pkgdir = File::Spec->catdir($PRSH_PKG_ROOT,$name);
    return unless -d $pkgdir;
    my $bindir = File::Spec->catdir($pkgdir,'bin');
    if (-d $bindir) {
        opendir my $dh,$bindir or return;
        while(my $f = readdir $dh){
            next if $f =~ /^\./;
            my $src = File::Spec->catfile($bindir,$f);
            next unless -f $src && -x $src;
            my $dst = File::Spec->catfile($PRSH_LOCAL_BIN,$f);
            unlink $dst if -l $dst;
            symlink $src,$dst unless -e $dst;
        }
        closedir $dh;
    }
    if (opendir my $pd, $pkgdir) {
        while (my $e = readdir $pd) {
            next if $e =~ /^\./;
            my $full = File::Spec->catfile($pkgdir,$e);
            next if -d $full;
            next unless -f $full;
            my $should_link = 0;
            if (-x $full) { $should_link = 1 }
            else {
                if (open my $fh, '<', $full) {
                    my $line = <$fh>;
                    close $fh;
                    if (defined $line && $line =~ /^\s*#!/) { $should_link = 1 }
                }
            }
            if ($should_link) {
                my $dst = File::Spec->catfile($PRSH_LOCAL_BIN,$e);
                unlink $dst if -l $dst;
                symlink $full,$dst unless -e $dst;
            }
        }
        closedir $pd;
    }
}

sub _unlink_package_bins {
    my ($name)=@_;
    my $pkgdir = File::Spec->catdir($PRSH_PKG_ROOT,$name);
    return unless -d $pkgdir;
    my @candidates;
    my $bindir = File::Spec->catdir($pkgdir,'bin');
    if (-d $bindir) {
        opendir my $dh,$bindir or return;
        while(my $f = readdir $dh){ next if $f =~ /^\./; push @candidates, $f }
        closedir $dh;
    }
    if (opendir my $pd, $pkgdir) {
        while (my $e = readdir $pd) {
            next if $e =~ /^\./;
            my $full = File::Spec->catfile($pkgdir,$e);
            next if -d $full;
            push @candidates, $e;
        }
        closedir $pd;
    }
    for my $f (@candidates) {
        my $dst = File::Spec->catfile($PRSH_LOCAL_BIN,$f);
        if (-l $dst) {
            my $target = readlink $dst;
            if (defined $target) {
                my $abs_target = File::Spec->rel2abs($target, Cwd::getcwd());
                my $pkg_target = File::Spec->rel2abs(File::Spec->catfile($pkgdir, $f), Cwd::getcwd());
                unlink $dst if $abs_target eq $pkg_target;
            }
        }
    }
}

# deps + progress sim
sub _resolve_dependencies {
    my ($pkg,$seen) = @_;
    $seen ||= {};
    return () if $seen->{$pkg}++;
    my @to_install = ();
    my $meta = _read_pkg_meta($pkg);
    my $depends = $meta->{depends} // [];
    if (ref($depends) eq 'ARRAY') {
        for my $d (@$depends) {
            next if -d File::Spec->catdir($PRSH_PKG_ROOT,$d);
            push @to_install, _resolve_dependencies($d,$seen);
            push @to_install, $d unless grep { $_ eq $d } @to_install;
        }
    }
    return @to_install;
}

sub _simulate_download {
    my ($label, $size_bytes) = @_;
    $size_bytes ||= int( (200 + rand()*2000) * 1024 );
    my $total = int($size_bytes);
    my $chunk = int($total / 60) || 1024;
    my $done = 0;
    while ($done < $total) {
        $done += int($chunk * (0.6 + rand()*0.8));
        $done = $total if $done > $total;
        my $pct = int($done * 100 / $total);
        my $bar = nice_bar($pct, 30, 32);
        my $szdone = human_bytes($done);
        my $sztot = human_bytes($total);
        my $line = sprintf("%s %s %s/%s", color("::",35), $bar, $szdone, $sztot);
        print "\r$line";
        sleep(0.02 + rand()*0.06);
    }
    print "\n";
}

sub _simulate_install {
    my ($pkg) = @_;
    my $total_steps = 100;
    for my $i (1..$total_steps) {
        my $pct = int($i * 100 / $total_steps);
        my $bar = nice_bar($pct, 30, 36);
        print "\r", color("::",35), " Installing ", color($pkg,36), " $bar";
        sleep(0.005 + rand()*0.01);
    }
    print "\n";
}

sub detect_system_pkg { return 'pkg' if which('pkg'); return 'apt' if which('apt-get') || which('apt'); return 'dnf' if which('dnf'); return 'pacman' if which('pacman'); return 'apk' if which('apk'); return undef; }

sub pkg_install_system {
    my ($name) = @_;
    return say color("error: ",31) . " Usage: neutron -S --system <name>" unless $name;
    my $mgr = detect_system_pkg() or return say color("error: ",31) . "No system package manager detected";
    my @cmd;
    if($mgr eq 'pkg'){ @cmd = ('sudo','pkg','install','-y',$name) }
    elsif($mgr eq 'apt'){ @cmd = ('sudo','apt','install','-y',$name) }
    elsif($mgr eq 'pacman'){ @cmd = ('sudo','pacman','-S','--noconfirm',$name) }
    elsif($mgr eq 'dnf'){ @cmd = ('sudo','dnf','install','-y',$name) }
    elsif($mgr eq 'apk'){ @cmd = ('sudo','apk','add',$name) }
    else { return say color("error: ",31) . "System manager $mgr not supported" }
    say color(":: ",35) . "Running system package manager ($mgr) to install " . color($name,36) . " ...";
    my $rc = system(@cmd);
    if ($rc == 0) {
        say color(":: ",35) . color("System package installed: ",32) . color($name,36);
        return 1;
    } else {
        say color("error: ",31) . "System install failed";
        return 0;
    }
}

sub pkg_install_git {
    my ($git_url, $system_flag) = @_;
    return say color("error: ",31) . " Usage: neutron -S <git_url|local_dir|pkgname> [--system]" unless $git_url;

    my ($pkgname) = $git_url =~ m{/([^/]+?)(?:\.git)?$};
    $pkgname ||= 'pkg_' . time();

    if ($system_flag) { say color(":: ",35) . "System install requested for " . color($pkgname,36); return pkg_install_system($pkgname) }

    my $dest = File::Spec->catdir($PRSH_PKG_ROOT,$pkgname);
    if(-d $dest){ say color(":: ",35) . color("Package '$pkgname' is already installed",33); return }
    print color(":: ",35) . "Proceed with installation of " . color($pkgname,36) . "? [Y/n] ";
    my $answer = <STDIN>; chomp $answer if defined $answer; $answer //= '';
    if ($answer =~ /^n/i) { say color(":: ",35) . "Installation cancelled."; return; }

    say color(":: ",35) . "Retrieving package: " . color($pkgname,36);
    if (-e $dest && !-d $dest) { say color("error: ",31) . "invalid package destination"; return }
    make_path($dest); # create target dir first
    open my $null, '>', '/dev/null' or die;
    my $old_stdout = select $null;
    my $rc = system('git','clone','--depth','1','--quiet',$git_url,$dest);
    select $old_stdout;
    close $null;
    if($rc != 0){ remove_tree($dest); say color("error: ",31) . "failed to retrieve package"; return }

    my $meta = _read_pkg_meta($pkgname);
    $meta->{name}    = $pkgname;
    $meta->{source}  = $git_url;
    $meta->{type}    = 'git';
    $meta->{enabled} = 1 unless defined $meta->{enabled};
    _write_pkg_meta($pkgname,$meta);

    my @deps = ();
    if ($meta->{depends} && ref($meta->{depends}) eq 'ARRAY' && @{$meta->{depends}}) {
        @deps = _resolve_dependencies($pkgname);
    }

    say color(":: ",35) . "Starting transaction...";
    if (@deps) {
        say color(":: ",35) . "resolving dependencies...";
        say " -> " . join(", ", @deps);
    } else {
        say color(":: ",35) . "resolving dependencies... nothing to do.";
    }

    my @all = (@deps, $pkgname);
    for my $p (@all) {
        say color(":: ",35) . "downloading " . color($p,36) . "...";
        my $pm = _read_pkg_meta($p);
        my $size = $pm->{size} ? $pm->{size} * 1024 : int( (300 + rand()*1200) * 1024 );
        _simulate_download($p, $size);
    }

    say color(":: ",35) . color("verifying package integrity...", 36);
    sleep(0.2);
    for my $p (@all) {
        say color(":: ",35) . "installing " . color($p,36) . "...";
        _simulate_install($p);
        my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$p);
        make_path($dir) unless -d $dir;
        my $m = _read_pkg_meta($p);
        $m->{name}    = $p unless $m->{name};
        $m->{enabled} = 1 unless defined $m->{enabled};
        _write_pkg_meta($p,$m);
        _link_package_bins($p);
        say color(":: ",35) . color("Installed ",32) . color($p,36);
    }

    say color(":: ",35) . color("Transaction completed.",32);
    say color(":: ",35) . color("Successfully installed ",32) . color($pkgname,36);
}

sub pkg_install_local {
    my ($src, $system_flag) = @_;
    return say color("error: ",31) . " Usage: neutron -S <git_url|local_dir|pkgname> [--system]" unless $src;

    my $pkgname = basename($src);
    if ($system_flag) { say color(":: ",35) . "System install requested for " . color($pkgname,36); return pkg_install_system($pkgname) }

    return say color("error: ",31) . "source directory not found" unless -d $src;
    my $dest = File::Spec->catdir($PRSH_PKG_ROOT,$pkgname);
    if(-d $dest){ say color(":: ",35) . color("Package '$pkgname' is already installed",33); return }
    print color(":: ",35) . "Proceed with installation of " . color($pkgname,36) . "? [Y/n] ";
    my $answer = <STDIN>; chomp $answer if defined $answer; $answer //= '';
    if ($answer =~ /^n/i) { say color(":: ",35) . "Installation cancelled."; return; }

    say color(":: ",35) . "Preparing to install local package: " . color($pkgname,36);
    if (-e $dest && !-d $dest) { say color("error: ",31) . "invalid package destination"; return }
    make_path($dest);
    my $rc = system('cp','-a',"$src/.",$dest);
    if($rc != 0){ remove_tree($dest); say color("error: ",31) . "copy operation failed"; return }

    my $meta = _read_pkg_meta($pkgname);
    $meta->{name}    = $pkgname;
    $meta->{source}  = Cwd::getcwd() . "/$src";
    $meta->{type}    = 'local';
    $meta->{enabled} = 1 unless defined $meta->{enabled};
    _write_pkg_meta($pkgname,$meta);

    say color(":: ",35) . "Starting transaction...";
    my @deps = ();
    if ($meta->{depends} && ref($meta->{depends}) eq 'ARRAY' && @{$meta->{depends}}) {
        @deps = _resolve_dependencies($pkgname);
    }
    if (@deps) {
        say color(":: ",35) . "resolving dependencies...";
        say " -> " . join(", ", @deps);
    } else {
        say color(":: ",35) . "resolving dependencies... nothing to do.";
    }
    my @all = (@deps, $pkgname);
    for my $p (@all) {
        say color(":: ",35) . "downloading " . color($p,36) . "... (local copy)";
        my $pm = _read_pkg_meta($p);
        my $size = $pm->{size} ? $pm->{size} * 1024 : int( (100 + rand()*600) * 1024 );
        _simulate_download($p, $size);
    }
    say color(":: ",35) . "installing...";
    for my $p (@all) {
        _simulate_install($p);
        _link_package_bins($p);
        say color(":: ",35) . color("Installed ",32) . color($p,36);
    }
    say color(":: ",35) . color("Transaction completed.",32);
    say color(":: ",35) . color("Successfully installed ",32) . color($pkgname,36);
}

sub pkg_list {
    opendir my $dh,$PRSH_PKG_ROOT or return say "No packages";
    while(my $d = readdir $dh){
        next if $d =~ /^\./;
        my $meta = _read_pkg_meta($d) || {};
        printf "%-20s %s %s\n", $d, ($meta->{version}//''), ($meta->{enabled} ? "[ENABLED]" : "[DISABLED]");
    }
    closedir $dh;
}

sub pkg_remove {
    my ($name)=@_;
    return say color("error: ",31) . " Usage: neutron uninstall <name>" unless $name;
    my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$name);
    return say color("error: ",31) . "package '$name' is not installed" unless -d $dir;
    print color(":: ",35) . "Proceed with removal of " . color($name,36) . "? [Y/n] ";
    my $answer = <STDIN>; chomp $answer if defined $answer; $answer //= '';
    if ($answer =~ /^n/i) { say color(":: ",35) . "Removal cancelled."; return; }
    say color(":: ",35) . "Removing package: " . color($name,36);
    _unlink_package_bins($name);
    remove_tree($dir);
    say color(":: ",35) . color("Successfully removed ",32) . color($name,36);
}

sub pkg_enable  { my ($name)=@_; return say color("error: ",31) . " Usage: neutron enable <name>"  unless $name; my $meta = _read_pkg_meta($name); $meta->{enabled} = 1; _write_pkg_meta($name,$meta); _link_package_bins($name);  say color(":: ",35) . "Enabled $name"; }
sub pkg_disable { my ($name)=@_; return say color("error: ",31) . " Usage: neutron disable <name>" unless $name; my $meta = _read_pkg_meta($name); $meta->{enabled} = 0; _write_pkg_meta($name,$meta); _unlink_package_bins($name); say color(":: ",35) . "Disabled $name"; }

sub pkg_update {
    my ($name)=@_;
    if(!$name || $name eq '--all' || $name eq '' ){
        say color(":: ",35) . "synchronizing package databases...";
        _simulate_download("neutron-db", 50 * 1024);
        my $count = 0;
        opendir my $dh,$PRSH_PKG_ROOT or return;
        my @gitpkgs;
        while(my $d = readdir $dh){
            next if $d =~ /^\./;
            my $m = _read_pkg_meta($d);
            push @gitpkgs, $d if $m->{type} && $m->{type} eq 'git';
        }
        closedir $dh;
        if (!@gitpkgs) {
            say color(":: ",35) . color("Nothing to do.",32);
            return;
        }
        say color(":: ",35) . "checking for updates...";
        for my $d (@gitpkgs) {
            say color(":: ",35) . "updating " . color($d,36) . "...";
            my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$d);
            open my $null, '>', '/dev/null' or next;
            my $old_stdout = select $null;
            my $rc = system('git','-C',$dir,'pull','--ff-only','--quiet');
            select $old_stdout;
            close $null;
            if ($rc == 0) {
                _simulate_download($d, int( (50 + rand()*500) * 1024 ));
                say color(":: ",35) . color("Updated ",32) . color($d,36);
                $count++;
            } else {
                say color(":: ",35) . color("Already up-to-date ",90) . color($d,36);
            }
        }
        say color(":: ",35) . color("Updated $count package(s)",32);
        return
    }
    my $meta = _read_pkg_meta($name);
    return say color("error: ",31) . "unknown package or not a git package" unless $meta && $meta->{type} eq 'git';
    say color(":: ",35) . "Updating " . color($name,36) . "...";
    my $dir = File::Spec->catdir($PRSH_PKG_ROOT,$name);
    open my $null, '>', '/dev/null' or return say color("error: ",31) . "update failed";
    my $old_stdout = select $null;
    my $rc = system('git','-C',$dir,'pull','--ff-only','--quiet');
    select $old_stdout;
    close $null;
    if($rc == 0){ _simulate_download($name, int( (100 + rand()*800) * 1024 )); say color(":: ",35) . color("Successfully updated ",32) . color($name,36) } else { say color("error: ",31) . "update failed" }
}

sub pkg_info {
    my ($name)=@_;
    return say color("error: ",31) . " Usage: neutron --info <name>" unless $name;
    my $m = _read_pkg_meta($name);
    if(!$m || !%$m){ say "No metadata for $name"; return }
    for my $k (sort keys %$m){ printf "%-15s: %s\n", $k, $m->{$k} }
}

sub load_enabled_packages {
    opendir my $dh,$PRSH_PKG_ROOT or return;
    while(my $d = readdir $dh){
        next if $d =~ /^\./;
        my $m = _read_pkg_meta($d);
        next unless $m->{enabled};
        if($m->{entry}){
            my $entry = File::Spec->catfile($PRSH_PKG_ROOT,$d,$m->{entry});
            if(-f $entry){
                do $entry;
                warn "package $d load failed: $@" if $@;
            }
        }
    }
    closedir $dh;
}

